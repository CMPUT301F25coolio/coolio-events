<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Taken from: Google Gemini                             -->
    <!-- Prompt: how to change the colour of a switch material -->
    <!-- Taken by: Avery Dancocks                              -->
    <!-- Taken on: 09/30/25                                    -->

    <!-- Color when switch is disabled -->
    <item android:state_enabled="false"
        android:color="@color/dark_grey" />
    <!-- Color when switch is ON -->
    <item android:color="@color/thumb_geolocation_on" android:state_checked="true" />

    <!-- Color when switch is OFF - default -->
    <item android:color="@color/thumb_geolocation_off" />
</selector>
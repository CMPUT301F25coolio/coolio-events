<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="roundedcornerimageview">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20sp</item>
    </style>

    <!-- Taken From: Google Gemini -->
    <!-- Prompt: How do I modify a tage widget?-->
    <!-- Taken By: Avery Dancocks -->
    <!-- Taken On: 11/29/25 -->
    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/light_green</item>
        <item name="shapeAppearance">@style/MyIndicatorShape</item>
    </style>

    <style name="MyIndicatorShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <style name="PurpleButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/light_purple</item>
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="YellowButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/light_yellow</item>
        <item name="android:textColor">@color/dark_yellow</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="GreenButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/light_green</item>
        <item name="android:textColor">@color/dark_green</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="RedButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/light_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="GreyButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/light_grey</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="GreyWidget" parent="Widget.AppCompat.TextView">
        <item name="backgroundTint">@color/light_grey</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="PurpleWidget" parent="Widget.AppCompat.TextView">
        <item name="backgroundTint">@color/light_purple</item>
        <item name="android:textColor">@color/dark_purple</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">50dp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="ShapeAppearance.App.PillShape" parent="ShapeAppearanceOverlay.Material3.Chip">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.App.TagChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipStrokeColor">@color/dark_grey</item>
        <item name="android:textAppearance">@style/TextAppearance.App.ChipText</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.PillShape</item>
    </style>

    <style name="TextAppearance.App.ChipText" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item> <!-- Add both for compatibility -->
    </style>

    <style name="Theme.App.Chip" parent="">
        <item name="chipStyle">@style/Widget.App.TagChip</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2962FF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/organizer_event_back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Send Notifications"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Poster -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/eventViewPoster"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:shapeAppearance="@style/roundedcornerimageview"
        tools:srcCompat="@tools:sample/avatars" />


    <TextView
        android:id="@+id/eventViewName"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="51dp"
        android:autoSizeTextType="uniform"
        android:text="Event Title"

        app:layout_constraintStart_toEndOf="@+id/eventViewPoster"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/eventViewName2"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:autoSizeTextType="uniform"
        android:text="Send Notifications To:"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/waitListButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/eventViewPoster"
        app:layout_constraintVertical_bias="0.732" />

    <Button
        android:id="@+id/waitListButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Waitlist Entrants"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#2962FF"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/chosenButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/sendMessageButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Send Notifications"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#50D732"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/chosenButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Chosen Entrants"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#8F949B"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cancelledButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/cancelledButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Cancelled Entrants"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#8F949B"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/acceptedButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/acceptedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Accepted Entrants"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#8F949B"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@+id/messageEditText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/messageEditText"
        android:layout_width="350dp"
        android:layout_height="150dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/edittextbackground"
        android:ems="10"
        android:hint="Type Message Here"
        android:inputType="textMultiLine"
        app:layout_constraintBottom_toTopOf="@+id/sendMessageButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="top|left"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
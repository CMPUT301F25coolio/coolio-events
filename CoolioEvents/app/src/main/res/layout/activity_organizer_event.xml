<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2962FF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/organizer_event_back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="188dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Event"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/organizer_event_map_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Event"
            android:src="@drawable/ic_map"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/organizer_event_edit_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Event"
            android:src="@drawable/ic_edit_event"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">

            <!-- Poster -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/eventViewPoster"
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/roundedcornerimageview"
                tools:srcCompat="@tools:sample/avatars" />

            <!-- Title -->
            <TextView
                android:id="@+id/eventViewName"
                android:layout_width="280dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:autoSizeTextType="uniform"
                android:text="Event Title"
                app:layout_constraintStart_toEndOf="@+id/eventViewPoster"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Organizer -->
            <TextView
                android:id="@+id/eventViewOrganizer"
                android:layout_width="280dp"
                android:layout_height="25dp"
                android:layout_marginStart="5dp"
                android:autoSizeTextType="uniform"
                android:text="Posted By: Organizer"
                app:layout_constraintStart_toEndOf="@+id/eventViewPoster"
                app:layout_constraintTop_toBottomOf="@+id/eventViewName" />

            <!-- Description -->
            <TextView
                android:id="@+id/eventViewDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:lineSpacingExtra="4dp"
                android:text="This is the event description."
                android:textColor="#424242"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewPoster" />

            <!-- Event Info -->
            <TextView
                android:id="@+id/eventViewTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text="Time: "
                android:textColor="#212121"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewDescription" />

            <TextView
                android:id="@+id/eventViewLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="Location: "
                android:textColor="#212121"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewTime" />

            <TextView
                android:id="@+id/eventViewRegistrationPeriod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="Registration Period: "
                android:textColor="#212121"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewLocation" />

            <TextView
                android:id="@+id/eventViewLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="Max Entrees: "
                android:textColor="#212121"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewRegistrationPeriod" />

            <TextView
                android:id="@+id/eventViewWaitlistLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="Waitlist Limit: "
                android:textColor="#212121"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewLimit" />

            <!-- Event Status Row -->
            <TextView
                android:id="@+id/eventViewEventStatusLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:text="Event Status:"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewWaitlistLimit" />

            <TextView
                android:id="@+id/eventViewEventStatus"
                android:layout_width="100dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:text="Open"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:gravity="center"
                android:background="@drawable/greenshapebackground"
                app:layout_constraintStart_toEndOf="@+id/eventViewEventStatusLabel"
                app:layout_constraintTop_toBottomOf="@+id/eventViewWaitlistLimit" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tagsGroup"
                android:layout_width="350dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintStart_toEndOf="@+id/tagLabel"
                app:layout_constraintTop_toBottomOf="@+id/eventViewEventStatus" />

            <TextView
                android:id="@+id/tagLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="Tags:"
                android:textSize="17dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/eventViewEventStatusLabel" />

            <!-- Organizer buttons -->

            <Button
                android:id="@+id/view_lists_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="80dp"
                android:layout_marginEnd="40dp"
                android:text="View Event Lists"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:backgroundTint="#2962FF"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@+id/eventViewEventStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/draw_lottery_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="40dp"
                android:text="Draw From Lottery"
                android:textAllCaps="false"
                android:textColor="#A9A9A9"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#A9A9A9"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toBottomOf="@+id/view_lists_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/draw_new_user_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="40dp"
                android:text="Draw New User"
                android:enabled="false"
                android:textAllCaps="false"
                android:textColor="#A9A9A9"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#A9A9A9"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toBottomOf="@+id/draw_lottery_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/sendNotificationsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="40dp"
                android:text="Send Notifications"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:backgroundTint="#2962FF"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@+id/draw_new_user_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/save_qr_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="40dp"
                android:text="Save QR Code"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                app:backgroundTint="#2962FF"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@+id/sendNotificationsButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

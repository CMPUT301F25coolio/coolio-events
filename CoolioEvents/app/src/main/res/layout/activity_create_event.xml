<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0ED"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2962FF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/organizer_event_back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Create an Event"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Event Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Event Details"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Title"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittextbackground"
                android:hint="e.g., Campus Blood Drive"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Description"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etEventDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittextbackground"
                android:gravity="top"
                android:hint="Details entrants should know..."
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <!-- Registration Period -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Registration period"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etRegistrationPeriod"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittextbackground"
                android:hint="YYYY/MM/DD - YYYY/MM/DD"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <!-- Entrant Limit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Entrant limit"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etEntrantLimit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/edittextbackground"
                android:hint="Maximum participants"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <!-- Event Date and Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event date and time"
                android:textColor="#212121"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etEventDateTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittextbackground"
                android:hint="Time of the event"
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="24dp"/>

            <!-- Event Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Location"
                android:textColor="#212121"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etEventLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittextbackground"
                android:hint="Location of the event"
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="16dp"/>

            <!-- Geolocation Verification -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/geolocation_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Geolocation Verification for this Event"
                android:textColor="#212121"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <!-- Tags -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tags"
                android:textColor="#212121"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:gravity="center"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/etTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                >
                <com.google.android.material.chip.Chip
                    android:text="Contest"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true"
                    >
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Dance"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Party"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Kids"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Tech"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true"
                    >
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Sports"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Arts"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Food"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Workshop"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Music"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Learning"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:text="Games"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
            </com.google.android.material.chip.ChipGroup>

            <!-- Poster -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Upload Poster"
                android:textColor="#212121"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/imgPosterPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="8dp"
                android:background="#DDDDDD"
                android:contentDescription="Poster preview"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btnPickPoster"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/createbutton"
                android:text="Choose Poster Image"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/createbutton"
                android:text="Take Photo"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

        </LinearLayout>


    </ScrollView>

    <!-- Create -->
    <Button
        android:id="@+id/btnCreate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/createbutton"
        android:elevation="2dp"
        android:text="Create"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@color/medium_purple"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:layout_marginLeft="-10dp"
            android:contentDescription="Back"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

        </FrameLayout>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Create an Event"
            android:textColor="@color/white"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Event Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Event Details"
                android:textColor="#212121"

                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Title"
                android:textColor="#212121"
                android:textSize="15sp" />

            <!-- Description -->
            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/searchbar_background"
                android:fontFamily="@font/poppins_regular"
                android:hint="e.g. Campus Blood Drive"
                android:layout_marginBottom="25dp"
                android:inputType="text"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Description"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etEventDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="25dp"
                android:gravity="top"
                android:background="@drawable/searchbar_background"
                android:fontFamily="@font/poppins_regular"
                android:hint="Details entrants should know..."
                android:inputType="text"
                android:textSize="16sp"
                android:maxLines="5"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp" />

            <!-- Registration Period -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Registration period"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etRegistrationPeriod"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="25dp"
                android:fontFamily="@font/poppins_regular"
                android:background="@drawable/searchbar_background"
                android:hint="YYYY/MM/DD - YYYY/MM/DD"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp" />

            <!-- Entrant Limit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="4dp"
                android:text="Entrant limit"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etEntrantLimit"
                android:fontFamily="@font/poppins_regular"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/searchbar_background"
                android:hint="Maximum participants"
                android:inputType="number"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp" />

            <!-- Waiting list Limit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Waiting list limit (optional)"
                android:textColor="#212121"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etWaitingListLimit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="25dp"
                android:background="@drawable/searchbar_background"
                android:hint="Maximum entrants allowed in waiting list"
                android:inputType="number"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp" />

            <!-- Event Date and Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Event date and time"
                android:textColor="#212121"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etEventDateTime"
                android:layout_width="match_parent"
                android:fontFamily="@font/poppins_regular"
                android:layout_height="50dp"
                android:layout_marginBottom="25dp"
                android:background="@drawable/searchbar_background"
                android:hint="Time of the event"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp"/>

            <!-- Event Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Event Location"
                android:textColor="#212121"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etEventLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/poppins_regular"
                android:background="@drawable/searchbar_background"
                android:hint="Location of the event"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#66000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="25dp"/>

            <!-- Geolocation Verification -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/geolocation_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geolocation Varification"
                android:textColor="#212121"
                android:textSize="20sp"
                android:paddingBottom="10dp"
                android:paddingLeft="5dp"
                android:fontFamily="@font/poppins_regular"
                app:switchPadding="19dp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <!-- Tags -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tags"
                android:textColor="#212121"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:gravity="center"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/etTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                >
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Contest"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true"
                    >
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Dance"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Party"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Kids"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Tech"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true"
                    >
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Sports"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Arts"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Food"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Workshop"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Music"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Learning"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
                <com.google.android.material.chip.Chip
                    android:theme="@style/Theme.App.Chip"
                    android:background="@drawable/tag_selector"
                    android:text="Games"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:checkable="true">
                </com.google.android.material.chip.Chip>
            </com.google.android.material.chip.ChipGroup>

            <!-- Poster -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Upload Poster"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp"
                android:textColor="#212121" />

            <ImageView
                android:id="@+id/imgPosterPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="8dp"
                android:background="#DDDDDD"
                android:contentDescription="Poster preview"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btnPickPoster"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:textAllCaps="false"
                style="@style/PurpleButton"
                android:text="Choose Poster Image"
                android:textStyle="bold"/>
            <!-- qr section: same style as Edit Event -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event QR Code"
                android:textColor="#212121"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/imgQrPreview"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:background="#FFFFFFFF"
                android:contentDescription="QR code preview"
                android:scaleType="centerInside"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGenerateQr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:textAllCaps="false"
                style="@style/PurpleButton"
                android:text="Generate QR Code"
                android:textStyle="bold" />


        </LinearLayout>


    </ScrollView>

    <!-- Create -->
    <Button
        android:id="@+id/btnCreate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:textAllCaps="false"
        style="@style/GreenButton"
        android:elevation="2dp"
        android:text="Save"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
